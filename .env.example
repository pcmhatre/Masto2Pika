# Mastodon: Settings -> Development -> New Application (scope: read:statuses, or read)
MASTODON_INSTANCE_URL=https://your.instance.social
MASTODON_ACCESS_TOKEN=
MASTODON_ACCOUNT_ID=

# Pika: Settings -> App tokens
PIKA_TOKEN=

# Cloudflare KV (state storage): dash.cloudflare.com -> Workers & Pages -> KV
# for namespace ID; dash.cloudflare.com/profile/api-tokens for a token scoped
# to Account > Workers KV Storage > Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional: JSON array of substrings (domains, emoji, etc.) to exclude from
# crossposting, e.g. ["[REDACTED-EMOJI]","https://example.com/"]. Keep this out of
# source/README if you don't want the specific list publicly visible.
# EXCLUDED_CONTENT=[]

# Optional overrides (defaults shown)
# PIKA_ENDPOINT=https://pika.page/micropub
# PIKA_MEDIA_ENDPOINT=https://pika.page/micropub/media
